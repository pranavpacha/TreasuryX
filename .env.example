# Copy to backend/.env and adjust as needed. All variables are optional; sensible defaults are
# baked into backend/app/config.py.

TREASURYX_APP_NAME=TreasuryX
TREASURYX_ENVIRONMENT=development
TREASURYX_DATABASE_URL=sqlite:///./treasuryx.db
TREASURYX_DATA_MODE=demo
TREASURYX_MAX_UPLOAD_SIZE_BYTES=8388608
